@page
@model BffMvc.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<section class="mx-auto max-w-lg rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200 sm:p-10">
    <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700">Password updated</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Your password has been reset</h1>
        <p class="mt-4 text-slate-600">You can now sign in using your new password.</p>
    </div>

    <div class="mt-6 text-center">
        <a asp-page="./Login" class="rounded bg-slate-900 px-4 py-2 font-medium text-white transition hover:bg-slate-700">Continue to sign in</a>
    </div>
</section>
