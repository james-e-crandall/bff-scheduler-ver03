@page
@model BffMvc.Areas.Identity.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}

<section class="mx-auto max-w-md rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200 sm:p-10">
    <div class="mb-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700">Security check</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Two-factor authentication</h1>
    </div>

    <form method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="rounded border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>
        <input asp-for="Input.RememberMe" type="hidden" />
        <input asp-for="Input.ReturnUrl" type="hidden" />

        <div>
            <label asp-for="Input.TwoFactorCode" class="mb-2 block text-sm font-medium text-slate-700"></label>
            <input asp-for="Input.TwoFactorCode" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 shadow-sm outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200" autocomplete="one-time-code" />
            <span asp-validation-for="Input.TwoFactorCode" class="mt-1 block text-sm text-rose-600"></span>
        </div>

        <div class="flex items-center gap-2 text-sm text-slate-700">
            <input asp-for="Input.RememberMachine" class="h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500" />
            <label asp-for="Input.RememberMachine">Remember this machine</label>
        </div>

        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-3 font-semibold text-white transition hover:bg-slate-700">Log in</button>
    </form>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
