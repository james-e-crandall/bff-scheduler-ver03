@page
@model BffMvc.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<section class="mx-auto max-w-lg rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200 sm:p-10">
    <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700">Recovery sent</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Check your email</h1>
        <p class="mt-4 text-slate-600">
            If the email address is associated with an account, a password reset link has been generated.
        </p>
    </div>

    @if (TempData["ResetLink"] is string resetLink)
    {
        <div class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm font-medium text-slate-700">Reset link</p>
            <a href="@resetLink" class="mt-2 block break-all text-sm text-cyan-700 hover:text-cyan-900">@resetLink</a>
        </div>
    }

    <div class="mt-6 text-center">
        <a asp-page="./Login" class="rounded bg-slate-900 px-4 py-2 font-medium text-white transition hover:bg-slate-700">Back to sign in</a>
    </div>
</section>
